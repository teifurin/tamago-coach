    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec2 bowlCenter = "{18,-10}" {"hint":"Bowl centre on the counter (x, z) in cm; the bowl is 8 cm wide and 4 cm tall"}'
    - "// @input vec2 chopstickEnd = \"{11.6,-4.6}\" {\"hint\":\"Where the chopsticks' thick ends rest on the counter (x, z), between the pan and the bowl; the sticks aim at the bowl centre and lean on its near-left rim\"}"
    - '// @input float chopstickLengthCm = 22 {"hint":"Chopstick length, cm; shortened in 0.5 cm steps only if the pose cannot clear the card, handle, pan body, counter edge and bowl at this length (printed at awake)", "widget":"slider", "min":6, "max":24, "step":0.5}'
    - '// @input vec4 ceramicColor = "{0.93,0.90,0.85,1}" {"hint":"Ceramic glaze colour", "widget":"color"}'
