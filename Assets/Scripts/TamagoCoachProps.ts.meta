  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TamagoCoachProps – bowl, egg disc, chopsticks (static)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.Material bowlMaterial {"hint":"Lit PBR material for the bowl and the egg disc (EggLogPBR, roughness 0.4 = glazed)"}'
    - '// @input Asset.Material chopstickMaterial {"hint":"Lit PBR material for the chopsticks (HandleWoodPBR)"}'
    - '// @input Asset.Material shadowMaterial {"hint":"ShadowSoft (unlit vertex colour, no depth write) for the soft shadow under the bowl; none = no shadow"}'
    - '// @ui {"widget":"group_end"}'
