  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TamagoCoachEgg – layer, log and slices</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input SceneObject layerObject {\"hint\":\"Authored child SceneObject 'EggLayer' (flat cooking layer)\"}"
    - "// @input SceneObject logObject {\"hint\":\"Authored child SceneObject 'EggLog' (rolled log)\"}"
    - "// @input SceneObject slicesObject {\"hint\":\"Authored child SceneObject 'EggSlices' (six slices at Done)\"}"
    - '// @input Asset.Material material {"hint":"Unlit vertex-colour material (vertexBaseColorMaterial)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input float layerWidthCm = 12.4 {\"hint\":\"Layer width along X, cm (slightly inside the pan's 13 cm interior)\", \"widget\":\"slider\", \"min\":5, \"max\":20, \"step\":0.1}"
    - "// @input float layerLengthCm = 16.4 {\"hint\":\"Layer length along Z, cm (slightly inside the pan's 18 cm interior)\", \"widget\":\"slider\", \"min\":5, \"max\":25, \"step\":0.1}"
    - '// @input float layerThicknessCm = 0.5 {"hint":"Layer thickness, cm", "widget":"slider", "min":0.1, "max":2, "step":0.1}'
    - '// @input vec4 freshColor = "{1.0,0.80,0.12,1}" {"hint":"Layer colour when just poured (glossy, bright yellow)", "widget":"color"}'
    - '// @input vec4 setColor = "{0.98,0.93,0.66,1}" {"hint":"Layer colour when set and ready to roll (paler, matte)", "widget":"color"}'
    - '// @input vec4 logColor = "{0.98,0.86,0.36,1}" {"hint":"Colour of the rolled log and the slices", "widget":"color"}'
    - '// @input float logLengthCm = 11.5 {"hint":"Log length along X, cm", "widget":"slider", "min":4, "max":18, "step":0.5}'
    - '// @input float logRadius1Cm = 1.3 {"hint":"Log radius after the first roll, cm", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @input float logRadius2Cm = 1.9 {"hint":"Log radius after the second roll, cm", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @input float logRadius3Cm = 2.5 {"hint":"Log radius after the third roll, cm", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @input float panInnerLengthCm = 18 {"hint":"Pan interior length along Z, cm (keeps the log inside the far wall)", "widget":"slider", "min":10, "max":25, "step":0.5}'
    - '// @input float sliceCount = 6 {"hint":"Number of slices shown at Done", "widget":"slider", "min":2, "max":10, "step":1}'
    - '// @input float sliceGapCm = 0.4 {"hint":"Gap between slices, cm", "widget":"slider", "min":0, "max":2, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
