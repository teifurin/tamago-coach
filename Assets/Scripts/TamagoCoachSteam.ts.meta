  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TamagoCoachSteam – steam wisps over the pan (Heat)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.Material material {"hint":"ShadowSoft: unlit vertex-colour material, blendMode Normal, depthWrite off (white vertex colour = steam)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float puffDiameterCm = 2.2 {"hint":"Width of one puff at scale 1, cm (puffs grow from 0.7x to 1.3x over their life)", "widget":"slider", "min":1, "max":5, "step":0.1}'
