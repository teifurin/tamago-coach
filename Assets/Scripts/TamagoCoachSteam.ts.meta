    - '// @input float riseCm = 9 {"hint":"How far each puff rises over its life, cm", "widget":"slider", "min":3, "max":20, "step":0.5}'
    - '// @input float cycleSeconds = 1.8 {"hint":"Life of one puff (rise time), seconds", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @input float swayCm = 0.8 {"hint":"Sideways sway amplitude of the streak, cm", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - '// @input float maxAlpha = 0.14 {"hint":"Peak opacity of one puff (keep <= 0.15 so two stacked puffs stay under 30 %)", "widget":"slider", "min":0, "max":0.3, "step":0.01}'
    - "// @input float renderOrder = 6 {\"hint\":\"Render order of the translucent puffs (after the egg layer's 1 so they draw last)\", \"widget\":\"slider\", \"min\":0, \"max\":10, \"step\":1}"
    - '// @ui {"widget":"group_end"}'
