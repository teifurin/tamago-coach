  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TamagoCoachMain – step and timer state machine</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 cardUI {"hint":"Step card UI module (StepCard / TamagoCoachCardUI)"}'
    - '// @input AssignableType_2 ringUI {"hint":"Ring text UI module (RingText / TamagoCoachRingUI)"}'
    - '// @input AssignableType_3 controlsUI {"hint":"Next / Back / Demo x10 UI module (Controls / TamagoCoachControlsUI)"}'
    - '// @input AssignableType_4 ringMesh {"hint":"Timer ring geometry + pinch (TimerRing / TamagoCoachRingMesh)"}'
    - '// @input AssignableType_5 egg {"hint":"Egg visuals (Egg / TamagoCoachEgg)"}'
    - '// @input SceneObject rollArrow {"hint":"The roll arrow SceneObject (enabled only during a roll cue)"}'
    - '// @input Component.AudioComponent chimeAudio {"hint":"AudioComponent on ChimeAudio (at the pan); drop a WAV on it if none is set"}'
    - '// @input AssignableType_6 steam {"hint":"Steam wisps over the pan (Steam / TamagoCoachSteam); shown only while the Heat countdown runs"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float demoSpeedFactor = 10 {"hint":"Timer speed multiplier while Demo x10 is on", "widget":"slider", "min":2, "max":20, "step":1}'
    - '// @input float cardCollapseSeconds = 6 {"hint":"Seconds after a countdown starts before the card collapses to ring + title (scaled by Demo)", "widget":"slider", "min":0, "max":30, "step":0.5}'
    - '// @input bool demoAtStart {"hint":"Start with Demo x10 on"}'
    - '// @input float startAtStep {"hint":"0-based step to open at start (0 = Prep); a later step starts with the earlier layers already rolled - useful for testing", "widget":"slider", "min":0, "max":5, "step":1}'
    - '// @input float pulseCount = 3 {"hint":"Number of ring pulses at zero", "widget":"slider", "min":1, "max":6, "step":1}'
    - '// @input float donePulseSeconds = 0.6 {"hint":"Length of the warm Done pulse (card accent line and timer ring flash once), seconds", "widget":"slider", "min":0.2, "max":5, "step":0.1}'
    - '// @input bool spatialChime = true {"hint":"Play the chime as spatial audio at the pan (creates a runtime audio listener that follows the head)"}'
    - '// @input bool debugBounds {"hint":"Print the world bounds of every mesh under this object 1 s after start (layout check)"}'
    - '// @ui {"widget":"group_end"}'
