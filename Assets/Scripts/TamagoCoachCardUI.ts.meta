  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TamagoCoachCardUI – step card (step · title, instruction, tip)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Plate</span>"}'
    - '// @ui {"widget":"group_start", "label":"Plate"}'
    - '// @input float widthCm = 24 {"hint":"Card width, cm", "widget":"slider", "min":10, "max":40, "step":0.5}'
    - '// @input float heightCm = 12 {"hint":"Card height, cm", "widget":"slider", "min":6, "max":30, "step":0.5}'
    - '// @input float cornerRadiusCm = 1.5 {"hint":"Corner radius of the plate, cm", "widget":"slider", "min":0, "max":4, "step":0.1}'
    - '// @input vec4 plateColor = "{0.08,0.09,0.11,1}" {"hint":"Plate colour (dark; the additive display renders dark colours as nearly transparent)", "widget":"color"}'
    - '// @input float plateOpacity = 0.7 {"hint":"Plate opacity (blend mode Normal)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float borderCm = 0.15 {"hint":"Inset border thickness, cm (0 = no border)", "widget":"slider", "min":0, "max":0.5, "step":0.01}'
    - '// @input vec4 borderColor = "{1,1,1,0.36}" {"hint":"Border colour; its alpha is multiplied by the plate opacity (0.36 x 0.7 = 25 % white)", "widget":"color"}'
    - '// @input vec4 accentColor = "{1,0.78,0.2,1}" {"hint":"Yolk accent line along the top edge", "widget":"color"}'
    - '// @input float accentCm = 0.3 {"hint":"Accent line thickness, cm", "widget":"slider", "min":0.1, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Text</span>"}'
    - '// @ui {"widget":"group_start", "label":"Text"}'
    - '// @input float titleSize = 56 {"hint":"Header row text size (step prefix and title; em-square, 43.886 = 1 cm)", "widget":"slider", "min":40, "max":120, "step":1}'
    - '// @input float bodySize = 50 {"hint":"Instruction text size", "widget":"slider", "min":40, "max":100, "step":1}'
    - '// @input float tipSize = 44 {"hint":"Tip text size", "widget":"slider", "min":30, "max":100, "step":1}'
    - '// @input float stepWidthCm = 4.4 {"hint":"Width reserved for the step prefix in the header row, cm (left-aligned; the title follows after the gap)", "widget":"slider", "min":3, "max":10, "step":0.1}'
    - '// @input string stepFormat = "Step {n} ·" {"hint":"Format of the step prefix; {n} is the 1-based step number"}'
    - '// @input vec4 stepColor = "{1,0.78,0.2,1}" {"hint":"Step prefix colour (yolk)", "widget":"color"}'
    - '// @input vec4 titleColor = "{1,1,1,1}" {"hint":"Title colour", "widget":"color"}'
    - '// @input vec4 textColor = "{1,1,1,1}" {"hint":"Instruction colour", "widget":"color"}'
    - '// @input vec4 tipColor = "{1,1,1,0.6}" {"hint":"Tip colour (dimmer secondary text)", "widget":"color"}'
