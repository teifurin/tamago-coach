    - '// @input vec4 nextHoverColor = "{1,0.86,0.38,1}" {"hint":"Next plate colour while hovered (the glow)", "widget":"color"}'
    - '// @input vec4 nextPressColor = "{0.9,0.66,0.12,1}" {"hint":"Next plate colour while pinched", "widget":"color"}'
    - '// @input vec4 nextBorderColor = "{1,0.95,0.8,1}" {"hint":"Next border colour", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
