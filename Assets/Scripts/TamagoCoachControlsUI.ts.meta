    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Next button</span>"}'
    - '// @ui {"widget":"group_start", "label":"Next"}'
    - '// @input string nextLabel = "Next ›" {"hint":"Label on the Next button"}'
    - '// @input float labelSize = 60 {"hint":"Next label text size (em-square; 60 ~ 1 cm cap height)", "widget":"slider", "min":40, "max":100, "step":1}'
    - '// @input vec4 nextLabelColor = "{0.12,0.12,0.14,1}" {"hint":"Next label colour (dark on yolk)", "widget":"color"}'
